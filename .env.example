# Optional fallback for the event gallery. When the existing OAuth variables
# below are present, the server uses OAuth instead so browser-referrer API-key
# restrictions cannot break server-side Drive reads.
GOOGLE_DRIVE_API_KEY=

# Must be the same 32-byte secret (64 hex characters) configured in the Cloudflare Worker.
# It protects both public media handles and short-lived upload sessions.
MEDIA_TOKEN_SECRET=

# Optional; defaults to the deployed Cloudflare media worker URL.
PUBLIC_MEDIA_PROXY_URL=https://image-photobooth.laihoanganh456.workers.dev

# Server-to-server event folder resolver. Keep the secret identical to the
# GALLERY_RESOLVER_SECRET configured on the tanhbooth-api Worker.
GALLERY_RESOLVER_URL=https://tanhbooth-api.laihoanganh456.workers.dev
GALLERY_RESOLVER_SECRET=

# Optional: only needed if the public /portfolio order-upload flow is enabled.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_DRIVE_ROOT_FOLDER_ID=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
